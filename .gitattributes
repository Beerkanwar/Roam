# Files that run inside Linux containers or on Linux servers must keep LF line endings,
# even when the repository is checked out on Windows (core.autocrlf=true).
*.sh               text eol=lf
*.conf             text eol=lf
*.Dockerfile       text eol=lf
Dockerfile         text eol=lf
roam_proxy_params  text eol=lf
deploy/.env.example text eol=lf
