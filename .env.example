# PostgreSQL Database Configuration
POSTGRES_USER=roam
POSTGRES_PASSWORD=replace_with_secure_random_db_password
POSTGRES_DB=roam

# Public Domain / Host / Web Origins
PUBLIC_WEB_ORIGIN=https://app.example.com
PUBLIC_API_HOST=api.example.com

# TURN Server Configuration (coturn)
TURN_HOST=turn.example.com
TURN_REALM=turn.example.com
TURN_SECRET=replace_with_secure_random_turn_secret
TURN_EXTERNAL_IP=your_public_ipv4_address

# Initial Startup Administrator & Volunteer Bootstrap (Optional - env gated)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=AdminPassword123!
BOOTSTRAP_VOLUNTEER_EMAILS=volunteer@example.com
