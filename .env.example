# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=mysecretpassword
POSTGRES_DB=roam_dev
ConnectionStrings__DefaultConnection=Host=localhost;Database=roam_dev;Username=postgres;Password=mysecretpassword

# Maps and Geocoding
VITE_MAP_API_KEY=your_maptiler_api_key_here
Geocoding__Endpoint=https://nominatim.openstreetmap.org/search
Geocoding__ApiKey=your_geocoding_api_key_here

# WebRTC TURN Server
TurnServer__Uris=turn:your.turn.server:3478,turns:your.turn.server:5349
TurnServer__Username=your_turn_username
TurnServer__Password=your_turn_password
