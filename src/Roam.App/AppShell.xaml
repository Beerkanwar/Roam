<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Roam.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Roam.App.Views"
    Title="Roam">

    <TabBar>
        <Tab Title="Home">
            <ShellContent
                Title="Home"
                ContentTemplate="{DataTemplate views:HomePage}"
                Route="HomePage" />
        </Tab>
        <Tab Title="Explore">
            <ShellContent
                Title="Explore"
                ContentTemplate="{DataTemplate views:ExplorePage}"
                Route="ExplorePage" />
        </Tab>
        <Tab Title="Volunteer">
            <ShellContent
                Title="Volunteer"
                ContentTemplate="{DataTemplate views:VolunteerDashboardPage}"
                Route="VolunteerDashboardPage" />
        </Tab>
        <Tab Title="Live Session">
            <ShellContent
                Title="Live Session"
                ContentTemplate="{DataTemplate views:LiveSessionPage}"
                Route="LiveSessionPage" />
        </Tab>
    </TabBar>

</Shell>
