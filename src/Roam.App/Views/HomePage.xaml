<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Roam.App.ViewModels"
             x:Class="Roam.App.Views.HomePage"
             x:DataType="vm:HomeViewModel"
             Title="{Binding Title}"
             BackgroundColor="#F8FAFC">

    <ScrollView>
        <VerticalStackLayout Padding="24,28" Spacing="24" MaximumWidthRequest="600" HorizontalOptions="Center">

            <!-- Hero Section -->
            <Border StrokeThickness="0" BackgroundColor="#0F172A" Padding="24" StrokeShape="RoundRectangle 16">
                <VerticalStackLayout Spacing="12">
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Label Text="🌍" FontSize="26" VerticalOptions="Center" />
                        <Label Text="ROAM" FontSize="28" FontAttributes="Bold" TextColor="#38BDF8" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Label Text="Human-Powered Exploration" FontSize="18" FontAttributes="Bold" TextColor="#F8FAFC" />
                    <Label Text="Connect with local volunteers around the world and experience destinations live through authentic real-time human interaction."
                           FontSize="14" TextColor="#94A3B8" LineHeight="1.3" />
                </VerticalStackLayout>
            </Border>

            <!-- Authentication State Card -->
            <Border StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="White" Padding="20" StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Account Status" FontSize="12" TextColor="#64748B" FontAttributes="Bold" />
                            <Label Text="{Binding CurrentUserName}" FontSize="16" FontAttributes="Bold" TextColor="#1E293B" />
                            <Label Text="{Binding VolunteerStatusText}" FontSize="13" TextColor="#0284C7" IsVisible="{Binding IsAuthenticated}" />
                        </VerticalStackLayout>
                        
                        <Button Grid.Column="1" Text="Sign Out" Command="{Binding LogoutCommand}" 
                                IsVisible="{Binding IsAuthenticated}"
                                BackgroundColor="#F1F5F9" TextColor="#475569" FontSize="13" HeightRequest="36" Padding="12,0" CornerRadius="8" />
                    </Grid>

                    <!-- Guest CTA -->
                    <VerticalStackLayout Spacing="10" IsVisible="{Binding IsNotAuthenticated}">
                        <Label Text="Sign in to request live tours, explore destinations, or volunteer." FontSize="13" TextColor="#64748B" />
                        <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                            <Button Grid.Column="0" Text="Sign In" Command="{Binding LoginCommand}"
                                    BackgroundColor="#0284C7" TextColor="White" FontAttributes="Bold" HeightRequest="44" CornerRadius="8" />
                            <Button Grid.Column="1" Text="Create Account" Command="{Binding RegisterCommand}"
                                    BackgroundColor="#F1F5F9" TextColor="#0F172A" FontAttributes="Bold" HeightRequest="44" CornerRadius="8" />
                        </Grid>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Quick Direct Session Join -->
            <Border StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="White" Padding="20" StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Join a Live Session" FontSize="15" FontAttributes="Bold" TextColor="#0F172A" />
                    <Label Text="Enter the session ID provided by your tour host:" FontSize="13" TextColor="#64748B" />
                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                        <Entry Grid.Column="0" Placeholder="Session ID..." Text="{Binding JoinSessionId}"
                               BackgroundColor="#F8FAFC" FontSize="14" HeightRequest="44" />
                        <Button Grid.Column="1" Text="Join Call" Command="{Binding JoinSessionCommand}"
                                BackgroundColor="#0F766E" TextColor="White" FontAttributes="Bold" HeightRequest="44" Padding="16,0" CornerRadius="8" />
                    </Grid>
                    <Label Text="{Binding ErrorMessage}" TextColor="#DC2626" FontSize="12" IsVisible="{Binding HasError}" />
                </VerticalStackLayout>
            </Border>

            <!-- Volunteer Dispatch Quick Access -->
            <Border StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="White" Padding="20" StrokeShape="RoundRectangle 12">
                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="Volunteer Program" FontSize="15" FontAttributes="Bold" TextColor="#0F172A" />
                        <Label Text="Guide explorers around your local city or landmark." FontSize="13" TextColor="#64748B" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="Volunteer Panel" Command="{Binding VolunteerDashboardCommand}"
                            BackgroundColor="#0284C7" TextColor="White" FontAttributes="Bold" HeightRequest="40" Padding="14,0" CornerRadius="8" />
                </Grid>
            </Border>

            <!-- Mission Footer -->
            <VerticalStackLayout Spacing="4" HorizontalOptions="Center" Padding="0,12">
                <Label Text="Roam — Open Source &amp; Non-Profit" FontSize="12" TextColor="#94A3B8" HorizontalOptions="Center" />
                <Label Text="Free Exploration • Privacy First • Volunteer Autonomy" FontSize="11" TextColor="#CBD5E1" HorizontalOptions="Center" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
