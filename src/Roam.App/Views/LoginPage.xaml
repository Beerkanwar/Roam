<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Roam.App.ViewModels"
             x:Class="Roam.App.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             Title="{Binding Title}"
             BackgroundColor="#F8FAFC">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="20" MaximumWidthRequest="420" HorizontalOptions="Center" VerticalOptions="Center">

            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                <Label Text="Welcome Back" FontSize="24" FontAttributes="Bold" TextColor="#0F172A" HorizontalOptions="Center" />
                <Label Text="Sign in to your Roam account" FontSize="14" TextColor="#64748B" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <Border StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="White" Padding="24" StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="16">

                    <!-- Error Alert -->
                    <Border StrokeThickness="1" Stroke="#FCA5A5" BackgroundColor="#FEF2F2" Padding="12" StrokeShape="RoundRectangle 8"
                            IsVisible="{Binding HasError}">
                        <Label Text="{Binding ErrorMessage}" TextColor="#B91C1C" FontSize="13" />
                    </Border>

                    <!-- Email Input -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Email Address" FontSize="13" FontAttributes="Bold" TextColor="#334155" />
                        <Entry Placeholder="explorer@example.com" Text="{Binding Email}" Keyboard="Email" HeightRequest="44" />
                    </VerticalStackLayout>

                    <!-- Password Input -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Password" FontSize="13" FontAttributes="Bold" TextColor="#334155" />
                        <Entry Placeholder="••••••••" Text="{Binding Password}" IsPassword="True" HeightRequest="44" />
                    </VerticalStackLayout>

                    <!-- Sign In Button -->
                    <Button Text="Sign In" Command="{Binding LoginCommand}" 
                            BackgroundColor="#0284C7" TextColor="White" FontAttributes="Bold" HeightRequest="46" CornerRadius="8" Margin="0,8,0,0" />

                    <!-- Busy Indicator -->
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#0284C7" />

                    <!-- Register Link -->
                    <Button Text="Don't have an account? Register" Command="{Binding NavigateToRegisterCommand}"
                            BackgroundColor="Transparent" TextColor="#0284C7" FontSize="13" />

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
